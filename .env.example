# Copy this file to .env and paste ONE real key. .env is ignored by git.
# Groq (free tier available, used by the live site): https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
# Or Claude (takes priority if both are set)
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: override the model (defaults: openai/gpt-oss-120b on Groq, claude-opus-5-5 on Claude)
# RECALL_MODEL=openai/gpt-oss-20b

# Optional, for trying the screens without any AI calls (canned questions, clearly labelled)
# RECALL_MOCK=1
